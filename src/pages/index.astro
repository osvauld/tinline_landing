---
import Layout from '../layouts/Layout.astro';
import DevicePreview from '../components/DevicePreview.astro';
import { TIN, TIN_STROKE } from '../../playground/src/lib/ui/tin-icons.gen';
const downloads = 'https://github.com/osvauld/tinline/releases/latest';
// Keep the visible version and APK links together when a release is published.
const androidVersion = '0.2.3';
const androidDownloads = `https://github.com/osvauld/tinline/releases/download/v${androidVersion}`;
---
<Layout title="Tinline · Messaging without a phone number">
  <main id="main">
    <section class="shell hero">
      <div class="hero-copy">
        <h1 class="big">Why build another messenger?</h1>
        <div class="prose">
          <p>Tinline lets you keep several identities in one app, without a phone number or email. Use separate accounts for different circles, projects or communities, without another SIM or a service account registration.</p>
          <p>It also explores a question: can a useful messaging app run with very little shared infrastructure? Devices exchange messages directly when possible, and member devices host groups. In the Play edition, a small notification service wakes Android phones for incoming messages and calls, so the app doesn’t need to keep a connection open all day.</p>
          <p>The experiment is making this practical enough for everyday conversations, with less infrastructure to operate.</p>
        </div>
        <section class="android-editions" aria-labelledby="android-editions-heading">
          <h2 id="android-editions-heading">Two Android editions</h2>
          <p class="muted">Both let you create multiple identities without a phone number or email.</p>
          <div class="grid two">
            <article class="card edition">
              <h3>Tinline Play</h3>
              <p>Uses Google’s notification service to wake for incoming messages and calls, so the app can sleep between exchanges. Requires Google Play services.</p>
              <a class="button quiet" href={`${androidDownloads}/tinline-play-v${androidVersion}.apk`}>Download Play APK ↗</a>
            </article>
            <article class="card edition">
              <h3>Tinline Liberum</h3>
              <p>Contains no Google SDKs. It keeps a background connection open instead, and only the selected account stays reachable.</p>
              <a class="button quiet" href={`${androidDownloads}/tinline-liberum-v${androidVersion}.apk`}>Download Liberum APK ↗</a>
            </article>
          </div>
          <p class="small">Android downloads: v{androidVersion}. Only the selected account is reachable in this release. Play support for receiving messages and calls on other remembered accounts is coming in v0.2.4.</p>
        </section>
        <div class="install">
          <span>On Linux:</span>
          <code id="install-command">curl -fsSL https://tinline.osvauld.com/install.sh | sh</code>
          <button class="install-copy" type="button" aria-label="Copy Linux install command" title="Copy to clipboard" hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={TIN_STROKE} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={TIN.copy[1].body} />
          </button>
          <span class="vh" id="install-feedback" role="status"></span>
        </div>
        <p class="small"><a href={downloads}>All releases and Linux packages ↗</a></p>
        <p class="status">Currently in alpha · Android and Linux</p>
      </div>
      <div class="hero-preview">
        <h2>Give the UI a try.</h2>
        <DevicePreview id="explore" route="/chats" title="Explore Tinline" />
        <p class="scene-note">A design preview with made-up conversations; no real messages are sent.</p>
      </div>
      <p class="note-line"><strong>Not for emergency calls.</strong> Use your phone's own dialler for emergency services.</p>
    </section>
  </main>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>('.install-copy');
  const command = document.querySelector('#install-command');
  const feedback = document.querySelector('#install-feedback');
  if (button && command && feedback && navigator.clipboard?.writeText) {
    button.hidden = false;
    let reset: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      clearTimeout(reset);
      button.disabled = true;
      try {
        await navigator.clipboard.writeText(command.textContent ?? '');
        button.title = 'Copied to clipboard';
        feedback.textContent = 'Install command copied to clipboard.';
      } catch {
        button.title = 'Could not copy. Try again.';
        feedback.textContent = 'Could not copy. Select the command and copy it manually.';
      } finally {
        button.disabled = false;
        reset = setTimeout(() => { button.title = 'Copy to clipboard'; }, 3000);
      }
    });
  }
</script>
