{
  "name": "tinline-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "astro build && npm run build:play",
    "build:play": "npm --prefix playground run build -- --base=/play/ --outDir ../dist/play --emptyOutDir",
    "preview": "astro preview",
    "check": "npm --prefix playground run check && node scripts/check-build.mjs"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "astro": "7.3.7" }
}
